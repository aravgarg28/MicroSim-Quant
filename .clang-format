---
Language: Cpp
BasedOnStyle: Google
Standard: c++20
ColumnLimit: 100
IndentWidth: 2
AccessModifierOffset: -1
DerivePointerAlignment: false
PointerAlignment: Left
AllowShortFunctionsOnASingleLine: Inline
AlwaysBreakTemplateDeclarations: Yes
IncludeBlocks: Regroup
IncludeCategories:
  # Own module headers ("microsim/...") come last so a header's own dependencies
  # are always compiled first — self-containment is checked by ordering.
  - Regex: '^<[a-z_]+>$'
    Priority: 1
  - Regex: '^<.*\.h(pp)?>$'
    Priority: 2
  - Regex: '^"microsim/'
    Priority: 3
  - Regex: '.*'
    Priority: 4
SortIncludes: CaseSensitive
SeparateDefinitionBlocks: Always
