# Curated check list per docs/build/BUILD_SYSTEM.md.
#
# Excluded with reason:
#   modernize-use-trailing-return-type  - style preference, not a defect class
#   readability-identifier-length       - fights domain-conventional short names (q, px)
#   cppcoreguidelines-avoid-magic-numbers / readability-magic-numbers
#                                       - noisy in tests and table-driven fixtures
#   *-avoid-c-arrays                    - std::array is already the convention; noise
#   bugprone-easily-swappable-parameters- unavoidable with (price, qty) style APIs
Checks: >
  -*,
  bugprone-*,
  performance-*,
  portability-*,
  modernize-*,
  readability-*,
  cppcoreguidelines-init-variables,
  cppcoreguidelines-narrowing-conversions,
  cppcoreguidelines-pro-type-member-init,
  cppcoreguidelines-slicing,
  cppcoreguidelines-virtual-class-destructor,
  misc-const-correctness,
  misc-misplaced-const,
  misc-unused-parameters,
  misc-unused-using-decls,
  -modernize-use-trailing-return-type,
  -readability-identifier-length,
  -readability-magic-numbers,
  -cppcoreguidelines-avoid-magic-numbers,
  -modernize-avoid-c-arrays,
  -cppcoreguidelines-avoid-c-arrays,
  -bugprone-easily-swappable-parameters

WarningsAsErrors: ''
HeaderFilterRegex: '.*/microsim/.*'
FormatStyle: file

CheckOptions:
  - key: readability-braces-around-statements.ShortStatementLines
    value: '2'
  - key: readability-function-cognitive-complexity.Threshold
    value: '30'
